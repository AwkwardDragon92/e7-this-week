{
  "name": "e7-this-week",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "build:vercel": "node scripts/migrate.mjs --optional && node scripts/seed.mjs --if-empty --optional && next build",
    "newsletter:preview": "node --env-file-if-exists=.env.local scripts/newsletter.mjs --preview newsletter-preview.html",
    "newsletter:draft": "node --env-file-if-exists=.env.local scripts/newsletter.mjs --draft"
  },
  "dependencies": {
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
