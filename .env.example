# Postgres (Neon via Vercel Marketplace sets this automatically). Without it the
# site renders from data/*.json and forms reply "opens soon".
DATABASE_URL=

# Public site URL (used for metadata, sitemap, robots, OG)
NEXT_PUBLIC_SITE_URL=https://epic7.awkwarddragon.com

# Admin API: send "Authorization: Bearer <ADMIN_TOKEN>". Must be 16+ chars or admin is disabled.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# Resend (optional). Signups are added to the segment (needs a full-access key; a sending-only key
# skips this quietly and signups stay in Postgres); sponsor inquiries are emailed to OWNER_EMAIL.
RESEND_API_KEY=
# Segment that signups join (Resend replaced audiences with segments). RESEND_AUDIENCE_ID still works as a fallback.
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
OWNER_EMAIL=
# Sender for owner notifications. Must be on a domain verified in Resend, e.g. "E7 This Week <hello@awkwarddragon.com>"
RESEND_FROM=
